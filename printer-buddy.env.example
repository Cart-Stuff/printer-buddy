# Copied to printer-buddy.env by install.sh. Edit, then: sudo systemctl restart printer-buddy
PORT=8080

# Share links: the domain viewers see (Cloudflare Worker in front of each box's tunnel).
# Leave empty to make links that only work on your own network.
PB_SHARE_DOMAIN=printerbuddy.stream

# Setup (install.sh asks for these; re-run it to change them)
PB_UI=basic
PB_AI=off
PB_VIDEO=snapshots
PB_NOTIFY=basic
PB_REMOTE=off
PB_USERS=single

# SCAN_SUBNETS=192.168.1.0/24
# PROBE_PORTS=7125,80
# Notifications are set up in the web page (Notifications button); these are only starting defaults.
# OFFLINE_GRACE=60   # seconds a printer must stay offline mid-print before alerting
# NTFY_URL=https://ntfy.sh/my-printers
# NTFY_TOKEN=
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# NOTIFY_EVENTS=started,paused,resumed,finished,failed,cancelled
LOG_LEVEL=INFO
